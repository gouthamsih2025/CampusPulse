# ==========================================
# CampusPulse Environment Configuration Template
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------
# Environment: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="CampusPulse API"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# CORS Origins (Comma-separated URLs allowed to call the backend)
# Local Next.js dev server: http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Connection URL
# For local dev without Postgres, fallback to SQLite: sqlite:///./campuspulse.db
# For PostgreSQL (local or cloud like Neon/Supabase/Railway/Render):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/campuspulse
DATABASE_URL=sqlite:///./campuspulse.db

# AI Triage / NLP Integration (Optional)
# Leave blank to use built-in high-accuracy deterministic keyword/regex heuristic parser
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
# URL pointing to the FastAPI backend API root
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
