# ==========================================
# CampusPulse Environment Configuration Template
# ==========================================

# ------------------------------------------
# DATABASE CONFIGURATION (MongoDB / Mongoose)
# ------------------------------------------
# Local MongoDB: mongodb://127.0.0.1:27017/campuspulse
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/campuspulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campuspulse

# ------------------------------------------
# APPLICATION ENVIRONMENT
# ------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="CampusPulse"
PORT=3000

# ------------------------------------------
# BACKEND & API CONFIGURATION
# ------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------
# LEGACY BACKEND (Optional SQLite / Postgres)
# ------------------------------------------
DATABASE_URL=sqlite:///./campuspulse.db
